# ═══════════════════════════════════════════════════════════════
# 📸 BIANCA 15 ANOS - Configuração do Cloudinary
# ═══════════════════════════════════════════════════════════════

# Seu Cloud Name do Cloudinary
# Encontre em: https://console.cloudinary.com/settings/c/general/settings/api_keys
CLOUDINARY_CLOUD_NAME=dstz2gnif

# Nome do seu Upload Preset (unsigned)
# Criado em: https://console.cloudinary.com/settings/c/upload/unsigned_upload_presets
# Exemplo: BIANCA
CLOUDINARY_UPLOAD_PRESET=BIANCA

# Porta local (padrão: 3000)
PORT=3000

# ═══════════════════════════════════════════════════════════════
# 📝 INSTRUÇÕES
# ═══════════════════════════════════════════════════════════════
#
# 1. Crie uma conta em https://cloudinary.com (grátis!)
#
# 2. Copie seu CLOUD_NAME de:
#    https://console.cloudinary.com/settings/c/general
#
# 3. Crie um Upload Preset "Unsigned" (sem API Secret):
#    a) Vá para: https://console.cloudinary.com/settings/c/upload
#    b) Clique em "Create upload preset"
#    c) Configure como: Unsigned | Type: Upload
#    d) Salve com o nome "BIANCA"
#    e) Copie o nome exato como CLOUDINARY_UPLOAD_PRESET
#
# 4. Coloque os valores neste arquivo (sem aspas)
#
# ═══════════════════════════════════════════════════════════════
# ⚠️  SEGURANÇA
# ═══════════════════════════════════════════════════════════════
#
# Com Upload Preset Unsigned:
# ✅ NUNCA exponha sua API Secret
# ✅ SEGURO para usar no frontend
# ✅ Controlos no Cloudinary (tamanho, tipo de arquivo, etc)
#
# Este arquivo (.env) NÃO será commitado ao Git
# Veja .gitignore para mais informações
#
# ═══════════════════════════════════════════════════════════════
